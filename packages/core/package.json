    "type": "git",
    "url": "git+https://github.com/idyWilliams/use-africa-pay.git"
  },
  "bugs": {
    "url": "https://github.com/idyWilliams/use-africa-pay/issues"
  },
  "homepage": "https://github.com/idyWilliams/use-africa-pay#readme",
  "type": "module",
  "main": "./dist/index.cjs",
